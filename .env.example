# Copie para `.env` e preencha. Nunca faça commit do `.env`.

# Gere com: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Em produção use um caminho difícil de adivinhar, ex.: painel-xyz/
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO

# Vazio = SQLite local (db.sqlite3). Produção: postgres://usuario:senha@host:5432/banco
DATABASE_URL=

# Opcional em dev. Vazio = fotos salvas em `media/`. Copie do painel do Cloudinary:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
